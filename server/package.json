{
    "name": "meri-shikayat-server",
    "version": "1.1.0",
    "description": "Backend API for Meri Shikayat complaint registration system",
    "main": "src/index.js",
    "type": "module",
    "scripts": {
        "dev": "nodemon src/index.js",
        "start": "node src/index.js",
        "test": "node ../scripts/run-api-tests.cjs unit",
        "test:integration": "node ../scripts/run-api-tests.cjs integration",
        "test:harness": "node ../scripts/run-api-tests.cjs harness",
        "test:watch": "node ../scripts/run-jest.cjs --watch",
        "test:coverage": "node ../scripts/run-api-tests.cjs unit --coverage",
        "test:production": "node test-production-readiness.js",
        "lint": "eslint src --ext .js",
        "seed": "node src/seeds/seed.js",
        "seed:dev": "NODE_ENV=development node src/seeds/seed.js",
        "seed:uat": "NODE_ENV=staging node src/seeds/seed.js",
        "migrate:admin-identities": "node src/migrations/migrate-admin-users-to-admins.js"
    },
    "keywords": [
        "complaint",
        "registration",
        "backend",
        "api"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@sentry/node": "^10.31.0",
        "@sentry/profiling-node": "^10.31.0",
        "@socket.io/redis-adapter": "^8.3.0",
        "axios": "^1.13.2",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "4.22.3",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.0.1",
        "file-type": "^21.1.1",
        "helmet": "^8.1.0",
        "ioredis": "^5.8.2",
        "joi": "^18.3.1",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.0",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^10.3.1",
        "rate-limit-redis": "^4.3.1",
        "sanitize-html": "^2.18.1",
        "sharp": "^0.35.5",
        "socket.io": "^4.8.3",
        "web-push": "^3.6.7",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "eslint": "^8.0.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.1",
        "supertest": "^7.1.4"
    }
}
