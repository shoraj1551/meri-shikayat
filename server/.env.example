# ========================================
# MERI SHIKAYAT - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ========================================
# REQUIRED - Application will fail without these
# ========================================

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/meri-shikayat-dev

# JWT Security (CRITICAL - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your-64-character-minimum-secret-key-here-change-this-in-production-use-crypto-random
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Node Environment (development | staging | production)
NODE_ENV=development

# ========================================
# CRITICAL FOR PRODUCTION - Email Service
# ========================================
# Required for password reset and email verification
# For Gmail: Use app-specific password (https://myaccount.google.com/apppasswords)

EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Alternative SMTP Configuration (if not using Gmail)
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password

# ========================================
# CRITICAL FOR PRODUCTION - Redis Cache
# ========================================
# Required for distributed rate limiting and caching
# Without Redis, rate limiting will use memory store (single instance only)

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# For Redis Cloud or AWS ElastiCache, use full connection URL:
# REDIS_URL=redis://username:password@host:port/db

# ========================================
# RECOMMENDED - SMS Service (Optional)
# ========================================
# For phone number verification via OTP
# Get API key from: https://www.fast2sms.com/

FAST2SMS_API_KEY=your-fast2sms-api-key

# ========================================
# SECURITY
# ========================================

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Session Secret (generate with crypto.randomBytes)
SESSION_SECRET=your-session-secret-64-characters-minimum-change-in-production

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# ========================================
# MONITORING & LOGGING (Production)
# ========================================

# Sentry Error Tracking (https://sentry.io)
SENTRY_DSN=
SENTRY_ENABLED=false

# PagerDuty Alerting (https://www.pagerduty.com)
PAGERDUTY_INTEGRATION_KEY=

# ========================================
# FEATURE FLAGS
# ========================================
# Enable/disable features without code changes

FEATURE_2FA=true
FEATURE_SOCIAL_AUTH=false
FEATURE_ML_CATEGORIZATION=false
FEATURE_AUTO_ASSIGNMENT=true
FEATURE_BULK_ACTIONS=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_CACHING=true

# ========================================
# FILE UPLOAD
# ========================================

MAX_FILE_SIZE=20971520
UPLOAD_PATH=./uploads

# Cloudinary Configuration (Optional - for cloud storage)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ========================================
# EXTERNAL SERVICES (Optional)
# ========================================

# ML Service for complaint categorization
ML_SERVICE_URL=
ML_SERVICE_ENABLED=false

# ========================================
# RATE LIMITING (Already configured with defaults)
# ========================================
# These are optional - defaults are production-ready
# Uncomment to override defaults

# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_OTP_MAX=3

# ========================================
# DATABASE (Advanced)
# ========================================

# MongoDB Connection Pool
# MONGODB_POOL_SIZE=50
# MONGODB_MAX_IDLE_TIME_MS=60000

# ========================================
# TRACING & PERFORMANCE (Optional)
# ========================================

TRACING_ENABLED=false
JAEGER_ENDPOINT=

# ========================================
# AWS SERVICES (Optional)
# ========================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ========================================
# NOTES
# ========================================
# 1. Generate secure secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 2. Never commit .env to version control
# 3. Use different values for development, staging, and production
# 4. Rotate secrets regularly (JWT_SECRET every 90 days)
# 5. For production, consider using AWS Secrets Manager or similar
