{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "name": "meri-shikayat-dev",
    "framework": null,
    "buildCommand": "npm run build-client",
    "outputDirectory": "client/dist",
    "build": {
        "env": {
            "VITE_API_URL": "https://meri-shikayat-api.onrender.com/api/v1",
            "VITE_SOCKET_URL": "https://meri-shikayat-api.onrender.com"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
