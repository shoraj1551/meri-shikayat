{
    "name": "meri-shikayat-root",
    "version": "1.1.0",
    "private": true,
    "packageManager": "npm@11.11.0",
    "engines": {
        "node": "24.19.0",
        "npm": "11.11.0"
    },
    "scripts": {
        "preinstall": "node scripts/check-toolchain.cjs",
        "check:toolchain": "node scripts/check-toolchain.cjs",
        "install-client": "npm ci --workspace client --include-workspace-root",
        "install-server": "npm ci --workspace server --include-workspace-root",
        "install-all": "npm ci",
        "build-client": "npm run build --workspace client && node scripts/verify-client-build.cjs",
        "vercel-build": "npm run build-client",
        "test:tooling": "node --test scripts/tests/*.test.cjs",
        "test:bootstrap": "node --test server/test/bootstrap/*.test.mjs",
        "test:container": "node scripts/test-api-container.mjs"
    },
    "workspaces": [
        "client",
        "server"
    ]
}
